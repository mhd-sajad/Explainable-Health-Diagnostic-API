# ╔══════════════════════════════════════════════════════════╗
# ║  Dockerfile — React Frontend (multi-stage build)        ║
# ╚══════════════════════════════════════════════════════════╝

# ── Stage 1: Build ──────────────────────────────────────
FROM node:20-alpine AS builder

WORKDIR /app

COPY frontend/package*.json ./
RUN npm ci --silent

COPY frontend/ .

# Point at the backend service name defined in docker-compose
ENV VITE_API_URL=http://localhost:8000

RUN npm run build

# ── Stage 2: Serve with Nginx ───────────────────────────
FROM nginx:alpine AS runner

LABEL maintainer="Muhammed Sajad <https://github.com/mhd-sajad>"
LABEL description="Explainable Cardiac Risk Diagnostic — React Frontend"

# Copy built assets
COPY --from=builder /app/dist /usr/share/nginx/html

# Custom nginx config for SPA routing
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
